[Unit]
Description=postfix-report: importa i log di Postfix e aggiorna i report statici
Documentation=https://github.com/fdefilippo/postfix-report
After=local-fs.target rsyslog.service

[Service]
Type=oneshot
User=postfix-report
Group=postfix-report
# Debian/Ubuntu: /var/log/mail.log è root:adm 0640.
# Enterprise Linux: /var/log/maillog è root:root 0600, usare le ACL (README).
SupplementaryGroups=adm
ExecStart=/usr/bin/postfix-report -config /etc/postfix-report/config.yaml update
# 3 = un'altra esecuzione è in corso (lock): non è un errore.
SuccessExitStatus=3
UMask=0022
Nice=10
IOSchedulingClass=idle

# Hardening: il programma non usa la rete e scrive solo DB e directory HTML.
# ProtectHostname, ProtectKernelLogs e ProtectClock richiedono systemd ≥ 242,
# 244 e 245; IPAddressDeny il firewall BPF di cgroup v2 (ridondante con
# PrivateNetwork). Il pacchetto EL8 (systemd 239) e "make install-systemd"
# con systemd < 245 le tolgono, per non avere "Unknown lvalue" nel journal.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/log
ReadWritePaths=/var/lib/postfix-report /var/www/html/postfix-report
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
